# Jira credentials for the SKILL EOD sheet upload.
# Replace REPLACE_WITH_ATLASSIAN_API_TOKEN with an Atlassian API token.
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
# The Jira user is the email below. Do not commit a filled-in copy to main.
# To keep the token off git, copy this file to jira.env and edit the copy.
# jira.env is gitignored. The uploader reads jira.env first, then this file.

JIRA_EMAIL=sowmiya.kirubakaran@arcadia.com
JIRA_API_TOKEN=REPLACE_WITH_ATLASSIAN_API_TOKEN
